# OpenAI GPT-6 Astra. Enter your own API key; never commit .env.
OPENAI_API_KEY=replace-with-your-own-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-6-astra
LLM_REASONING_EFFORT=low
LLM_TOKEN_PARAMETER=max_completion_tokens
# Optional extensions for another OpenAI-compatible endpoint.
LLM_EXTRA_BODY_JSON=

# Parallel actor requests; lower this if your provider rate-limits requests.
LLM_CONCURRENCY=4
LLM_TIMEOUT_SECONDS=180
LLM_MAX_OUTPUT_TOKENS=12000
LLM_MAX_RETRIES=2

# Python interpreter with requirements.txt installed.
PYTHON=python
